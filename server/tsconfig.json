{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true
  },
  "include": ["src", "../src/game-core", "../src/config", "../src/net"],
  "exclude": ["../src/**/*.test.ts"]
}
